# fMRI Navigation Experiment - Git Ignore File

# Results and data files (keep structure but ignore actual data)
Results/
results/
test_results/

# Archived folders (moved out of main tree during organization)
archive/
PTSOD/Results/

# Local-only: exploration stays on dev machine, not used on MRI PC
exploration/

# Temporary files
*.tmp
*.temp
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# MATLAB files
*.asv
*.m~

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Log files
*.log

# Backup files
*.backup
*.bak

# Large media files that might be too big for git
*.mp4
*.avi
*.mov
*.wmv

# Large data files
*.mat
*.csv
*.xlsx
*.xls

# Keep important CSV templates and examples
!*_template.csv
!*_example.csv
!Arenas.csv
!Final_New_Arenas.csv
!Final111_New_Arenas.csv

# Keep important instruction images
!PTSOD/Instructions_HE/*.png
!PTSOD/Stimuli/*/memory_screens_HE/*.png
!PTSOD/Stimuli/*/nomemory_screens_HE/*.png

# Keep sound files
!sounds/*.wav
!sounds/*.mp3

# Keep arena icons
!arenas_new_icons/**/*.png
!arenas_new_icons/**/*.svg

# Keep fixation cross images
!fixation_cross.png
!ptsod_fixation_cross.png
!exploration_fixation_cross.png

# Keep documentation
!*.md
!*.pdf
!*.docx
!*.rtf

# Keep configuration files
!requirements.txt
!*.bat
!*.py
!*.m
